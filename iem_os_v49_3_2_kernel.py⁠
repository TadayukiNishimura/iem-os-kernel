# 3. ANALYTICAL CPRE ENGINE WITH DYNAMIC COUNTERS
# ============================================================

class ExactAnalyticalCPreEngine:
    @staticmethod
    def compute_exact_action_invariant(
        safe_set: FullyCoupledJointSpace,
        u_classical: float, u_quantum: float,
        w_max: float, d_theta_max: float,
        safe_min: float, safe_max: float,
        max_iterations: int = 5
    ) -> Tuple[Optional[FullyCoupledJointSpace], bool]:
        curr_space = safe_set.clone()

        for iteration in range(max_iterations):
            new_constraints = []
            for c in curr_space.constraints:
                theta_coupling_coeff = abs(c.a_theta + c.a_x * u_classical)
                disturbance_margin = abs(c.a_x) * w_max + theta_coupling_coeff * d_theta_max
                
                quantum_drift = c.a_p_phi * (0.01 + 0.5 * u_quantum) + c.a_p_bit * (0.005 + 0.2 * u_quantum)
                adjusted_b = c.b - disturbance_margin - quantum_drift
                
                new_c = CoupledConstraint(
                    a_x=c.a_x,
                    a_theta=c.a_theta + c.a_x * u_classical,
                    a_p_phi=c.a_p_phi,
                    a_p_bit=c.a_p_bit,
                    b=adjusted_b
                )
                new_constraints.append(new_c)

            next_space = FullyCoupledJointSpace(curr_space.constraints + new_constraints)
            
            if next_space.is_empty:
                return None, False

            xmin, xmax, _, _, _, _, _, _, status = next_space.get_exact_bounds()
            if status != "SAT" or xmin < safe_min - 1e-12 or xmax > safe_max + 1e-12:
                return None, False

            if next_space.is_subset_of(curr_space) and curr_space.is_subset_of(next_space):
                return next_space, True  # CONVERGED

            curr_space = next_space

        return curr_space, False  # NOT_CONVERGED


