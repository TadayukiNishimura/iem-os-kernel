class V4932CertifiedKernelNode:
    def __init__(self, node_id: int, safe_min: float = 0.0, safe_max: float = 3.0, w_max: float = 0.05, d_theta_max: float = 0.02, v_max: float = 0.02):
        self.node_id = node_id
        self.safe_min = safe_min
        self.safe_max = safe_max
        self.w_max = w_max
        self.d_theta_max = d_theta_max
        self.v_max = v_max
        self.action_set = (-1.0, -0.5, 0.0, 0.5, 1.0, 1.5)
        self.quantum_intervention_set = (-0.1, 0.0, 0.1)
        
        self.safe_set = FullyCoupledJointSpace()
        self.current_belief = FullyCoupledJointSpace.create_initial_belief_x0()
        
        self.invariant_family: Dict[Tuple[float, float], FullyCoupledJointSpace] = {}
        self.ledger = V4932UASOSLedger()
        self.fail_closed = False

    def compute_invariant_family(self) -> Tuple[Set[Tuple[float, float]], int, int, int]:
        """Returns (safe_pairs, total_checked, total_converged, total_subset_certified)"""
        if self.fail_closed or self.safe_set.is_empty:
            return set(), 0, 0, 0

        safe_pairs = set()
        self.invariant_family.clear()
        total_checked = 0
        total_converged = 0
        total_subset_certified = 0

        for u_c in self.action_set:
            for u_q in self.quantum_intervention_set:
                total_checked += 1
                invariant_space, success = ExactAnalyticalCPreEngine.compute_exact_action_invariant(
                    self.safe_set, u_c, u_q, self.w_max, self.d_theta_max, self.safe_min, self.safe_max
                )
                if success and invariant_space is not None and not invariant_space.is_empty:
                    total_converged += 1
                    if self.current_belief.is_subset_of(invariant_space):
                        total_subset_certified += 1
                        safe_pairs.add((u_c, u_q))
                        self.invariant_family[(u_c, u_q)] = invariant_space

        return safe_pairs, total_checked, total_converged, total_subset_certified

    def evaluate_nominal_mpc_cost(self, u_c: float, u_q: float, target_x: float = 1.3) -> float:
        xmin, xmax, tmin, tmax, _, _, _, _, _ = self.current_belief.get_exact_bounds()
        x_mid = 0.5 * (xmin + xmax)
        t_mid = 0.5 * (tmin + tmax)
        predicted_x = x_mid + t_mid * u_c
        return (predicted_x - target_x) ** 2 + 0.1 * (u_c ** 2) + 0.2 * (u_q ** 2)

    def select_action_and_bind(
        self, step: int, agreed_pairs: Set[Tuple[float, float]]
    ) -> Optional[Tuple[float, float, AuditChainNode]]:
        if not agreed_pairs:
            self.fail_closed = True
            self.ledger.transition_state(GovernanceState.FAIL_CLOSED)
            node = self.ledger.bind_and_append(step, self.node_id, "FAMILY_EMPTY", "EMPTY", 0.0, 0.0, False)
            return None

        best_pair = min(agreed_pairs, key=lambda p: self.evaluate_nominal_mpc_cost(p[0], p[1]))
        u_c, u_q = best_pair

        xmin, xmax, _, _, _, _, _, _, _ = self.current_belief.get_exact_bounds()
        inv_payload = f"X:[{xmin:.4f},{xmax:.4f}]|UC:{u_c:.4f}|UQ:{u_q:.4f}"
        inv_hash = hashlib.sha256(inv_payload.encode('utf-8')).hexdigest()[:16]

        state_summary = f"X:[{xmin:.2f},{xmax:.2f}],U:{u_c:.2f}"
        audit_node = self.ledger.bind_and_append(step, self.node_id, inv_hash, state_summary, u_c, u_q, True)

        return u_c, u_q, audit_node

    def update_belief_state(self, y_obs: float, u_exec: float, u_q_exec: float) -> bool:
        xmin, xmax, tmin, tmax, pmin, pmax, bmin, bmax, _ = self.current_belief.get_exact_bounds()

        pred_constraints = list(self.current_belief.constraints)
        pred_constraints.append(CoupledConstraint(0.0, 1.0, 0.0, 0.0, tmax + self.d_theta_max))
        pred_constraints.append(CoupledConstraint(0.0, -1.0, 0.0, 0.0, -tmin + self.d_theta_max))

        forward_margin = self.w_max + abs(u_exec) * self.d_theta_max
        upper_bound_x = xmax + (tmax * u_exec if u_exec >= 0 else tmin * u_exec) + forward_margin
        lower_bound_x = xmin + (tmin * u_exec if u_exec >= 0 else tmax * u_exec) - forward_margin

        pred_constraints.append(CoupledConstraint(1.0, u_exec, 0.0, 0.0, upper_bound_x))
        pred_constraints.append(CoupledConstraint(-1.0, -u_exec, 0.0, 0.0, -lower_bound_x))

        predicted_space = FullyCoupledJointSpace(pred_constraints)

        post_constraints = predicted_space.constraints + [
            CoupledConstraint(1.0, u_exec, 0.0, 0.0, y_obs + self.v_max),
            CoupledConstraint(-1.0, -u_exec, 0.0, 0.0, -y_obs + self.v_max)
        ]

        posterior_space = FullyCoupledJointSpace(post_constraints)

        if posterior_space.is_empty:
            self.fail_closed = True
            self.ledger.transition_state(GovernanceState.FAIL_CLOSED)
            return False

        nx_min, nx_max, _, _, _, _, _, _, status = posterior_space.get_exact_bounds()
        if status != "SAT" or nx_min < self.safe_min - 1e-12 or nx_max > self.safe_max + 1e-12:
            self.fail_closed = True
            self.ledger.transition_state(GovernanceState.SAFE_MODE)
            return False

        self.current_belief = posterior_space
        return True


