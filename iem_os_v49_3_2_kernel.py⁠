        head = nodes[0].ledger.chain[-1]
        print(f"[GOVERNANCE] Final Ledger Chain Head Hash                        : {head.current_hash[:32]}... ")
        print(f"[GOVERNANCE] Final Governance State                              : {head.governance_state.name}")

    print("\n[FORMAL CERTIFICATION SUMMARY]")
    print(f" - CPre Fixed-Point Convergence : {cumulative_converged_pairs} / {cumulative_checked_pairs} action pairs converged")
    print(f" - Subset Containment (B_t ⊆ K*) : {cumulative_subset_certified} / {cumulative_checked_pairs} certified action pairs (Tri-State Fail-Closed Active)")
    print(f" - Empirical Safety Validation  : {'PASSED' if empirical_safety_pass else 'DETECTED ANOMALIES / FAIL-CLOSED'} (Under Declared Bounded Model)")
