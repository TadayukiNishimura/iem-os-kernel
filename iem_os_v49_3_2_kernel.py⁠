class SharedPhysicalPlant:
    def __init__(self, seed: int):
        self.x = 1.0
        self.theta = 0.1
        self.rng = random.Random(seed)

    def step(self, u: float, t: int, w_max: float, d_theta_max: float) -> float:
        w = self.rng.uniform(-w_max, w_max)
        d_theta = self.rng.uniform(-d_theta_max, d_theta_max)
        self.theta += d_theta
        self.x = self.x + self.theta * u + w
        return self.x

    def observe(self, v_max: float) -> float:
        return self.x + self.rng.uniform(-v_max, v_max)


def run_v49_3_2_benchmark(num_nodes: int = 3, seeds: int = 5, steps: int = 25):
    print("=" * 80)
    print("IEM-OS & QID-OS V49.3.2 PUBLICATION FINAL BASELINE (AUTO-EVALUATED & FROZEN)")
    print("=" * 80)
    print(f"Z3 SMT Solver Active: {Z3_AVAILABLE}")

    total_violations = 0
    joint_safety_violations = 0
    consensus_failures = 0
    truth_containment_successes = 0
    total_steps_evaluated = 0
    total_ledger_nodes = 0
    unknown_solver_count = 0
    
    cumulative_checked_pairs = 0
    cumulative_converged_pairs = 0
    cumulative_subset_certified = 0

    for seed_idx in range(seeds):
        seed = 40000 + seed_idx
        plant = SharedPhysicalPlant(seed=seed)
        nodes = [V4932CertifiedKernelNode(node_id=i, safe_min=0.0, safe_max=3.0, w_max=0.05, d_theta_max=0.02, v_max=0.02) for i in range(num_nodes)]

        for t in range(1, steps + 1):
            safe_sets = []
            for node in nodes:
                pairs, checked, converged, subset_cert = node.compute_invariant_family()
                safe_sets.append(pairs)
                if seed_idx == 0 and t == 1:
                    cumulative_checked_pairs += checked
                    cumulative_converged_pairs += converged
                    cumulative_subset_certified += subset_cert

            agreed_pairs = set.intersection(*safe_sets) if safe_sets else set()

            if not agreed_pairs:
                consensus_failures += 1
                for node in nodes:
                    node.fail_closed = True
                break

            outputs = [node.select_action_and_bind(t, agreed_pairs) for node in nodes]
            if any(o is None for o in outputs):
                break
            
            u_exec, u_q_exec = outputs[0][0], outputs[0][1]
            true_x = plant.step(u_exec, t, w_max=0.05, d_theta_max=0.02)
            true_theta = plant.theta

            local_spaces = []
            for node in nodes:
                y_obs = plant.observe(v_max=0.02)
                success = node.update_belief_state(y_obs, u_exec, u_q_exec)
                if success:
                    local_spaces.append(node.current_belief)
                    xmin, xmax, tmin, tmax, _, _, _, _, status = node.current_belief.get_exact_bounds()
                    if status == "UNKNOWN":
                        unknown_solver_count += 1
                    total_steps_evaluated += 1
                    if xmin <= plant.x <= xmax and tmin <= plant.theta <= tmax:
                        truth_containment_successes += 1

            consensus_space = intersect_coupled_spaces(local_spaces)
            if consensus_space is None or consensus_space.is_empty:
                consensus_failures += 1
                for node in nodes:
                    node.fail_closed = True
                break

            for node in nodes:
                node.current_belief = consensus_space

            if true_x < 0.0 or true_x > 3.0:
                total_violations += 1
            if true_theta < 0.05 or true_theta > 0.35:
                joint_safety_violations += 1

        total_ledger_nodes += len(nodes[0].ledger.chain)

    truth_containment_rate = (truth_containment_successes / total_steps_evaluated) * 100.0 if total_steps_evaluated > 0 else 0.0

    # Auto-Evaluated Empirical Safety Status
    empirical_safety_pass = (total_violations == 0 and joint_safety_violations == 0 and consensus_failures == 0)

    print("\n" + "=" * 80)
    print("V49.3.2 PUBLICATION FINAL BASELINE BENCHMARK AGGREGATE RESULTS")
    print("=" * 80)
    print(f"[FORMAL CERTIFICATION] SMT Unknown Query Count      : {unknown_solver_count}")
    print(f"[EMPIRICAL OBSERVER VALIDATION] Instantiated-State Truth Containment Rate : {truth_containment_rate:.2f}% ({truth_containment_successes}/{total_steps_evaluated})")
    print(f"[EMPIRICAL SAFETY] Physical X-State Safety Violations            : {total_violations}")
    print(f"[EMPIRICAL SAFETY] Joint-State (Theta) Safety Violations         : {joint_safety_violations}")
    print(f"[EMPIRICAL SAFETY] Consensus/Agreement Failures                 : {consensus_failures}")
    print(f"[EMPIRICAL SAFETY VALIDATION STATUS]                            : {'PASSED' if empirical_safety_pass else 'FAILED (Fail-Closed Triggered)'}")
    print(f"[GOVERNANCE] Total Audit Ledger Entries                          : {total_ledger_nodes}")
