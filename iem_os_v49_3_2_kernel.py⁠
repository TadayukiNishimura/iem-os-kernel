class GovernanceState(Enum):
    NORMAL = 0
    PROACTIVE_QUANTUM_CONTROL = 1
    DEGRADED = 2
    SAFE_MODE = 3
    FAIL_CLOSED = 4
    RECOVERY = 5


@dataclass
class AuditChainNode:
    index: int
    prev_hash: str
    payload_hash: str
    current_hash: str
    governance_state: GovernanceState


class V4932UASOSLedger:
    def __init__(self):
        self.genesis_hash = "0" * 64
        self.chain: List[AuditChainNode] = []
        self.current_state = GovernanceState.NORMAL

    def transition_state(self, new_state: GovernanceState):
        self.current_state = new_state

    def bind_and_append(
        self, step: int, node_id: int, invariant_hash: str, 
        state_summary: str, action: float, quantum_intervention: float, verified: bool
    ) -> AuditChainNode:
        prev_h = self.chain[-1].current_hash if self.chain else self.genesis_hash
        
        if not verified and self.current_state != GovernanceState.FAIL_CLOSED:
            self.current_state = GovernanceState.SAFE_MODE

        payload_str = (
            f"V49.3.2_FINAL|STEP:{step}|NODE:{node_id}|INV_HASH:{invariant_hash}|"
            f"STATE:{state_summary}|ACT:{action:.4f}|Q_INT:{quantum_intervention:.4f}|GOV:{self.current_state.name}"
        )
        payload_h = hashlib.sha256(payload_str.encode('utf-8')).hexdigest()

        chain_str = f"{prev_h}|{payload_h}|{self.current_state.name}"
        current_h = hashlib.sha256(chain_str.encode('utf-8')).hexdigest()

        node = AuditChainNode(
            index=len(self.chain),
            prev_hash=prev_h,
            payload_hash=payload_h,
            current_hash=current_h,
            governance_state=self.current_state
        )
        self.chain.append(node)
        return node


